# The Sun (sun) -- coarse_type=celestial
# curated single QID
# EO label is OPTIONAL: its absence is the coverage measurement.
SELECT ?item ?en ?eo ?sitelinks
  (GROUP_CONCAT(DISTINCT ?typeQid; SEPARATOR="|") AS ?types)
  (GROUP_CONCAT(DISTINCT ?enAlias; SEPARATOR="|") AS ?enAliases)
  (GROUP_CONCAT(DISTINCT ?eoAlias; SEPARATOR="|") AS ?eoAliases)
WHERE {
  VALUES ?item { wd:Q525 }
  ?item wikibase:sitelinks ?sitelinks .
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en)="en") }
  OPTIONAL { ?item rdfs:label ?eo FILTER(LANG(?eo)="eo") }
  OPTIONAL { ?item wdt:P31 ?type .
    BIND(STRAFTER(STR(?type), "entity/") AS ?typeQid) }
  OPTIONAL { ?item skos:altLabel ?enAlias FILTER(LANG(?enAlias)="en") }
  OPTIONAL { ?item skos:altLabel ?eoAlias FILTER(LANG(?eoAlias)="eo") }
}
GROUP BY ?item ?en ?eo ?sitelinks
ORDER BY DESC(?sitelinks)
