# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Databases (large binary files - don't commit these)
*.db
*.sqlite

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json

# Mining corpus — third-party content, not for public repo
data/mining/

# Generated analysis data — not for repo
data/analysis/*.csv
data/analysis/unknown_tokens_pooled.txt
# TinyStories probe run outputs (regenerable via fetch + batch_coverage_report)
data/analysis/tinystories_run/

# Mining candidates — generated, not source
data/domain_db/candidates_*.jsonl
data/domain_db/merged_candidates*.jsonl
data/domain_db/review_bucket_*.jsonl

# Esperanto root inventory — generated at build time from parseo (GPL-3.0)
# Regenerate: python src/lexicon/build_root_inventory.py --out data/lexicon_db/
data/lexicon_db/akademio_roots.txt
data/lexicon_db/eo_inventory.json

# Esperanto inventory — generated at build time from ESPDIC (CC-BY-3.0)
data/lexicon_db/eo_inventory.json
data/lexicon_db/akademio_roots.txt

# ESPDIC raw dictionary — regenerable (CC-BY-3.0), fetched by build/gapfill tools
data/lexicon_db/espdic.txt

# Review harness — regenerable snapshot & Excel working copies
data/analysis/gapfill/worksheet_export.tsv
data/analysis/gapfill/*.xlsx
